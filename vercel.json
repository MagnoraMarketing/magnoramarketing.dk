    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "nexusmarketing.dk"
        }
      ],
      "destination": "https://magnoramarketing.dk/",
      "permanent": true
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.nexusmarketing.dk"
        }
      ],
      "destination": "https://magnoramarketing.dk/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/admin/(.*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|robots.txt|llms.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
